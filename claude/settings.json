{
  "effortLevel": "high",
  "editorMode": "vim",
  "model": "claude-opus-4-6",
  "theme": "dark-ansi",
  "agentPushNotifEnabled": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(mas search:*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cc-clip-hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cc-clip-hook"
          }
        ]
      }
    ]
  }
}
